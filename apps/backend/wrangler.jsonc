{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
     {
       "binding": "DB",
       "database_name": "sayurin",
       "database_id": "ef36db09-6bed-4b8e-be84-0075ff38a700",
       "migrations_dir": "drizzle"
    }
  ],
  // WAJIB dikonfigurasi sebelum deploy:
  //   - JWT_SECRET  -> secret wajib untuk sign/verify JWT. Set dengan: `wrangler secret put JWT_SECRET`
  //                    (untuk dev lokal: salin apps/backend/.dev.vars.example ke .dev.vars)
  //   - CORS_ORIGIN -> opsional, daftar origin yang diizinkan dipisah koma. Default: localhost dev.
  // "vars": {
  //   "CORS_ORIGIN": "https://app.sayurin.com"
  // },
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
